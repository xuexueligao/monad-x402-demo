# Copy to project-root .env.arena.local, or contracts/.env.arena.local when running npm --prefix contracts.
# No mainnet deployment is supported. Use a funded Monad Testnet deployer wallet.
ARENA_DEPLOYER_PRIVATE_KEY=
ARENA_RESULT_SIGNER_ADDRESS=
# Alternative to the public signer address; this must match the backend signer.
ARENA_RESULT_SIGNER_PRIVATE_KEY=
ARENA_RPC_URL=https://testnet-rpc.monad.xyz
ARENA_CHAIN_ID=10143
ARENA_CHALLENGE_FEE_MON=10
ARENA_POOL_SHARE_BPS=8000
ARENA_REWARD_BPS=5000
ARENA_ROUND_DURATION_SECONDS=7200
# Optional testnet MON seed held by the contract. No automatic token funding is performed.
ARENA_SEED_MON=0
