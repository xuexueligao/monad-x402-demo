{
  "name": "dragonbait-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node scripts/run-local.mjs test",
    "test:arena": "node scripts/run-local.mjs arena",
    "demo": "node scripts/run-local.mjs demo",
    "node": "hardhat node --network local --hostname 127.0.0.1",
    "deploy:testnet": "node --env-file-if-exists=.env.local scripts/deploy-testnet.mjs",
    "deploy:arena": "node --env-file-if-exists=.env.arena.local scripts/deploy-arena.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "hardhat": "3.20.0",
    "solc": "0.8.37"
  },
  "overrides": { "tmp": "0.2.7" }
}
