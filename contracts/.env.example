# This file is independent of the old x402 app's environment. Copy to .env.local.
# Never use the same key/address for owner and agent.
DRAGONBAIT_RPC_URL=https://testnet-rpc.monad.xyz
DRAGONBAIT_DEPLOYER_PRIVATE_KEY=
DRAGONBAIT_OWNER_ADDRESS=
DRAGONBAIT_AGENT_ADDRESS=

# Example technical policy only; these are not finalized game/prize rules.
DRAGONBAIT_MAX_PAYMENT_MON=0.01
DRAGONBAIT_WINDOW_BUDGET_MON=0.05
DRAGONBAIT_WINDOW_SECONDS=86400
DRAGONBAIT_ALLOWED_RECIPIENTS=

# Zero by default. A positive value funds EACH vault after deployment.
DRAGONBAIT_SEED_EACH_MON=0
