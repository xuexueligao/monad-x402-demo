# Copy with `npm run setup:arena` to .env.arena.local. Never commit private keys.
# Network values verified against https://docs.monad.xyz/developer-essentials/testnet on 2026-10-17.
ARENA_RPC_URL=https://testnet-rpc.monad.xyz
ARENA_CHAIN_ID=10143
ARENA_CONTRACT_ADDRESS=
ARENA_DEPLOYMENT_BLOCK=

# Backend judgement signer (generated by setup:arena). This wallet needs no MON.
ARENA_RESULT_SIGNER_PRIVATE_KEY=
# Separate, funded TESTNET wallet used only by the deployment command.
ARENA_DEPLOYER_PRIVATE_KEY=
ARENA_RESULT_SIGNER_ADDRESS=
ARENA_CHALLENGE_FEE_MON=10
ARENA_POOL_SHARE_BPS=8000
ARENA_REWARD_BPS=5000
ARENA_ROUND_DURATION_SECONDS=7200
ARENA_SEED_MON=0

# OpenAI-compatible Chat Completions endpoint. Empty key explicitly enables local-rules mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

API_HOST=0.0.0.0
API_PORT=4000
ARENA_ALLOWED_ORIGINS=http://localhost:3150,http://127.0.0.1:3150
PUBLIC_JOIN_URL=http://localhost:3150/play
ARENA_POLL_INTERVAL_MS=2000

# Browser-safe public configuration only. Public variables are baked into `next build`.
# Leave API_URL empty for local/LAN development; it uses the page hostname on port 4000.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Optional: required only for cross-browser mobile WalletConnect, not wallet in-app browsers.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Retained legacy x402 example only; unused by Rug Arena.
PAY_TO_ADDRESS=
PUBLIC_DEMO_URL=
